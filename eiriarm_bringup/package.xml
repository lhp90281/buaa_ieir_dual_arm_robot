<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>eiriarm_bringup</name>
  <version>0.0.1</version>
  <description>Bringup for EiriArm</description>
  <maintainer email="user@todo.todo">user</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>

  <!-- Real-hardware bring-up (real_robot.launch.py) -->
  <exec_depend>w3_robot_bridge</exec_depend>
  <exec_depend>eiriarm_controllers</exec_depend>
  <exec_depend>dual_arm_support</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>controller_manager</exec_depend>

  <!-- Simulation bring-up (system / simulation / mujoco_sim launches) -->
  <exec_depend>eiriarm_mujoco</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
