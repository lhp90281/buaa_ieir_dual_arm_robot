<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>eiriarm_controllers</name>
  <version>0.0.0</version>
  <description>Eiriarm controllers using Pinocchio and ros2_control</description>
  <maintainer email="user@todo.todo">user</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Core ROS 2 dependencies -->
  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  
  <!-- ros2_control dependencies -->
  <depend>controller_interface</depend>
  <depend>hardware_interface</depend>
  <depend>pluginlib</depend>
  <depend>realtime_tools</depend>
  
  <!-- Geometry messages for Cartesian control -->
  <depend>geometry_msgs</depend>

  <!-- Trajectory messages for joint_position_controller -->
  <depend>trajectory_msgs</depend>
  
  <!-- Dynamics computation -->
  <depend>pinocchio</depend>

  <!-- DM hardware interface dependencies -->
  <depend>w3_robot_bridge</depend>
  <depend>yaml-cpp</depend>

  <!-- Python scripts (friction_identification.py) -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>dual_arm_support</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>controller_manager_msgs</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-matplotlib</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <exec_depend>eiriarm_mujoco</exec_depend>
  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>python3-pytest</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <controller_interface plugin="${prefix}/eiriarm_controllers.xml"/>
    <hardware_interface plugin="${prefix}/eiriarm_hardware_interface.xml"/>
    <hardware_interface plugin="${prefix}/dm_hardware_interface.xml"/>
  </export>
</package>
