<?xml version="1.0"?>
<!--
  ros2_control description for the dual 7-DoF arm (ieir).

  Pulls in dual_arm_robot_plug.urdf for the full kinematic + visual + inertial
  description, then appends a <ros2_control> block that binds DMHardwareInterface
  to the 14 arm motors through the W3 bridge:

    can0 / channel 0 / slot 0..6 = left_joint_0..6
    can1 / channel 1 / slot 0..6 = right_joint_0..6

  The two grippers (can0.slot7, can1.slot7) are intentionally NOT exposed here; they
  remain driven by the gripper_controller_node through W3 bridge and are not
  part of the ros2_control hardware. The real-hardware launch removes the
  gripper subtrees when gripper:=false before publishing robot_description.

  Effort limits below mirror the <limit effort=*> tags in the URDF; they are
  the SOFT limits the hardware interface clamps to (motor flash TMAX is higher).

  Usage (from launch):
    xacro $(find ieir_controllers)/config/dual_arm_ros2_control.urdf.xacro \
          offsets_yaml:=src/ros2_ws_config/joint_offsets_dual.yaml \
          arms:=dual          # or 'left' / 'right' to expose only one arm

  The 'arms' arg only affects which joints appear in the <ros2_control> block.
  The full kinematic / inertial model (both arms) is always included so the
  Pinocchio gravity computation remains correct.
-->
<robot name="dual_arm_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Calibration file (zero_offset, axis_sign for all 14 joints) -->
  <xacro:arg name="offsets_yaml" default=""/>

  <!-- Which arm(s) to expose to ros2_control: 'left', 'right' or 'dual'. -->
  <xacro:arg name="arms" default="dual"/>
  <xacro:property name="arms" value="$(arg arms)"/>

  <!-- Pull in the full dual-arm geometry / inertial model. -->
  <xacro:include filename="$(find dual_arm_support)/urdf/dual_arm_robot_plug.urdf"/>

  <!-- ====================================================================
       Macro: one DM joint with the standard MIT-mode interface set.
       ==================================================================== -->
  <xacro:macro name="dm_joint" params="name channel slot motor_type
                                       urdf_lower urdf_upper effort_max">
    <joint name="${name}">
      <param name="channel">${channel}</param>
      <param name="slot">${slot}</param>
      <param name="motor_type">${motor_type}</param>
      <param name="urdf_lower">${urdf_lower}</param>
      <param name="urdf_upper">${urdf_upper}</param>
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <command_interface name="effort">
        <param name="min">-${effort_max}</param>
        <param name="max">${effort_max}</param>
      </command_interface>
      <command_interface name="stiffness"/>
      <command_interface name="damping"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
  </xacro:macro>

  <ros2_control name="dual_arm_dm_system" type="system">
    <hardware>
      <plugin>ieir_controllers/DMHardwareInterface</plugin>
      <param name="offsets_yaml">$(arg offsets_yaml)</param>
      <param name="motor_topic_ns">/w3_robot_bridge_node</param>
      <param name="auto_enable">true</param>
    </hardware>

    <!-- ============== Left arm (W3 channel 0 / can0) ============== -->
    <xacro:if value="${arms == 'left' or arms == 'dual'}">
      <xacro:dm_joint name="left_joint_0" channel="0" slot="0"
                      motor_type="DM8009"
                      urdf_lower="-2.3562" urdf_upper="2.8798" effort_max="40.0"/>
      <xacro:dm_joint name="left_joint_1" channel="0" slot="1"
                      motor_type="DM8009"
                      urdf_lower="-3.0513" urdf_upper="0.3491" effort_max="40.0"/>
      <xacro:dm_joint name="left_joint_2" channel="0" slot="2"
                      motor_type="DM4340P"
                      urdf_lower="-2.5307" urdf_upper="2.5307" effort_max="27.0"/>
      <xacro:dm_joint name="left_joint_3" channel="0" slot="3"
                      motor_type="DM4340"
                      urdf_lower="-2.0944" urdf_upper="1.4835" effort_max="27.0"/>
      <xacro:dm_joint name="left_joint_4" channel="0" slot="4"
                      motor_type="DM4310"
                      urdf_lower="-2.5307" urdf_upper="2.5307" effort_max="7.0"/>
      <xacro:dm_joint name="left_joint_5" channel="0" slot="5"
                      motor_type="DM4310"
                      urdf_lower="-0.6981" urdf_upper="0.6981" effort_max="7.0"/>
      <xacro:dm_joint name="left_joint_6" channel="0" slot="6"
                      motor_type="DM4310"
                      urdf_lower="-1.5708" urdf_upper="1.5708" effort_max="7.0"/>
    </xacro:if>

    <!-- ============== Right arm (W3 channel 1 / can1) ============== -->
    <xacro:if value="${arms == 'right' or arms == 'dual'}">
      <xacro:dm_joint name="right_joint_0" channel="1" slot="0"
                      motor_type="DM8009"
                      urdf_lower="-2.8798" urdf_upper="2.3562" effort_max="40.0"/>
      <xacro:dm_joint name="right_joint_1" channel="1" slot="1"
                      motor_type="DM8009"
                      urdf_lower="-0.3491" urdf_upper="3.0543" effort_max="40.0"/>
      <xacro:dm_joint name="right_joint_2" channel="1" slot="2"
                      motor_type="DM4340P"
                      urdf_lower="-2.5307" urdf_upper="2.5307" effort_max="27.0"/>
      <xacro:dm_joint name="right_joint_3" channel="1" slot="3"
                      motor_type="DM4340"
                      urdf_lower="-2.0944" urdf_upper="1.5708" effort_max="27.0"/>
      <xacro:dm_joint name="right_joint_4" channel="1" slot="4"
                      motor_type="DM4310"
                      urdf_lower="-2.5307" urdf_upper="2.5307" effort_max="7.0"/>
      <xacro:dm_joint name="right_joint_5" channel="1" slot="5"
                      motor_type="DM4310"
                      urdf_lower="-0.6981" urdf_upper="0.6981" effort_max="7.0"/>
      <xacro:dm_joint name="right_joint_6" channel="1" slot="6"
                      motor_type="DM4310"
                      urdf_lower="-1.5708" urdf_upper="1.5708" effort_max="7.0"/>
    </xacro:if>

  </ros2_control>

</robot>
